# ==============================================================================
# JCER College ERP - Backend Production Environment Variables Template
# Copy this file to .env on the server and configure strong unique values.
# NEVER commit the actual .env file with production credentials to Git!
# ==============================================================================

# ── Server Configuration ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
API_URL=https://api.yourdomain.com/api

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# On Railway: Railway automatically provisions and injects DATABASE_URL:
# DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway
DATABASE_URL=
# Alternatively, discrete parameters (Docker / Manual host):
DB_HOST=postgres
DB_PORT=5432
DB_NAME=college_erp_db
DB_USER=erp_user
DB_PASSWORD=replace_with_strong_random_db_password_here
DB_SSL=false
DB_RLS_ENABLED=false

# ── Redis Cache & Queues ───────────────────────────────────────────────────────
# On Railway: If Railway Redis service is added, Railway injects REDIS_URL automatically:
# REDIS_URL=redis://default:password@redis.railway.internal:6379
REDIS_URL=
# Note: If REDIS_URL is not provided, the backend seamlessly operates with a resilient built-in in-memory store.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Authentication & JWT Secrets (Min 32 random characters) ────────────────────
JWT_SECRET=replace_with_super_secret_jwt_random_key_min_32_characters
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=replace_with_super_secret_refresh_random_key_min_32_characters
REFRESH_TOKEN_SECRET=replace_with_super_secret_refresh_random_key_min_32_characters

# ── Cloudflare R2 Private Object Storage ───────────────────────────────────────
R2_ENDPOINT=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=jcer-erp-bucket
R2_REGION=auto
R2_PUBLIC_URL=

# ── CORS & Domain Configuration ───────────────────────────────────────────────
CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ── Email & Notification Services ──────────────────────────────────────────────
EMAIL_OTP_ENABLED=true
EMAIL_USER=your_email_username
EMAIL_PASS=your_email_password
BREVO_API_KEY=
BREVO_SENDER_EMAIL=admissions@yourdomain.com
BREVO_SENDER_NAME=JCER Admissions
ADMIN_EMAIL=admissions@yourdomain.com
PRINCIPAL_EMAIL=principal@yourdomain.com

# ── Initial Admin Seed Credentials ─────────────────────────────────────────────
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=replace_with_strong_initial_admin_password
INITIAL_PRINCIPAL_EMAIL=principal@yourdomain.com
INITIAL_PRINCIPAL_PASSWORD=replace_with_strong_initial_principal_password
INITIAL_CYBERADMIN_EMAIL=cyberadmin@yourdomain.com
INITIAL_CYBERADMIN_PASSWORD=replace_with_strong_initial_cyberadmin_password

# ── Bulk Export & Background Worker ───────────────────────────────────────────
BULK_EXPORT_CONCURRENCY=15
BULK_EXPORT_MAX_RETRIES=3
BULK_EXPORT_RETENTION_HOURS=24

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
LOG_LEVEL=info

# ── Activity Monitoring & Student Auto-Logout ──────────────────────────────────
ACTIVE_USER_WINDOW_MINUTES=5
STUDENT_INACTIVITY_TIMEOUT_MINUTES=60